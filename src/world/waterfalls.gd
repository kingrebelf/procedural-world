class_name Waterfalls
## Natural waterfalls (v19 worlds with rivers). Rivers sit at a smoothed copy of the land,
## so where the land falls steeply a river just runs down a long ramp. Here and there
## (one 512 m cell in a few, never near a town, road or stronghold) that whole steep reach
## is gathered into one sheer drop, or two or three in a stair: the river runs on at its
## old level to a rock lip, falls into a plunge pool cut against the foot of the cliff and
## carries on below at the level it would have reached anyway. Nothing past the reach
## changes, so the river meets its old course again.
##
## Everything here is worked out from the seed alone (its own WHash salts, 1500 and up),
## the same from whichever chunk asks: the terrain, the river's water, the far land and
## the falls' water, mist and sound all agree.

const V := 20 ## the GEN_VERSION that brings them (WorldField.terrain_v)
const CELL := 512.0
const CHANCE := 0.6 ## of a cell with a steep enough reach having its falls
const RUN := 56.0 ## the steep reach a falls gathers, metres along the river
const MIN_DROP := 6.0
const MAX_DROP := 32.0
const LAT := 72.0 ## how far across the valley the step reaches (fading over the outer part)
const FADE := 24.0 ## past the reach, back to the river's own level
const RAMP := 2.5 ## the face of a drop is this steep a ramp (sheer on a 1 m heightmap)
const KEEP_CLEAR := 90.0 ## from roads, metres
const SCAN := 16.0
## Planned cells, shared by every generator (chunks are generated by fresh ones):
## [seed, terrain version, the planet's kind, ix, iz] -> the falls or {}.
static var _plans := {}
static var _lock := Mutex.new()
## The reach a falls covers, round its lip, for lookups.
const REACH := RUN + FADE + LAT

## The falls whose cell is (ix, iz), or {}: {lip: Vector2 (on the river's centre line),
## dir: Vector2 (downstream), top, drop, steps: PackedFloat32Array (distance of each drop
## from the lip), levels: PackedFloat32Array (the water below each), wob: Vector2 (the
## lip line's waver phases)}.
static func in_cell(gen: ChunkGenerator, ix: int, iz: int) -> Dictionary:
	var key := [gen.seed, WorldField.terrain_v, WorldField.snow_line, Eras.theme, str(WorldField.allowed_eras), ix, iz]
	_lock.lock()
	var have = _plans.get(key)
	_lock.unlock()
	if have != null:
		return have
	var f := plan(gen, ix, iz)
	if f.has("no"):
		f = {}
	_lock.lock()
	if _plans.size() > 2000:
		_plans.clear()
	_plans[key] = f
	_lock.unlock()
	return f

## Falls whose reach comes within the box.
static func near(gen: ChunkGenerator, x0: float, z0: float, x1: float, z1: float) -> Array:
	var out: Array = []
	if not gen.rivers or WorldField.terrain_v < V:
		return out
	for iz in range(int(floor((z0 - REACH) / CELL)), int(floor((z1 + REACH) / CELL)) + 1):
		for ix in range(int(floor((x0 - REACH) / CELL)), int(floor((x1 + REACH) / CELL)) + 1):
			var f := in_cell(gen, ix, iz)
			if f.is_empty():
				continue
			var l: Vector2 = f["lip"]
			if l.x + REACH >= x0 and l.x - REACH <= x1 and l.y + REACH >= z0 and l.y - REACH <= z1:
				out.append(f)
	return out

## The falls in cell (ix, iz), or {"no": why there is none}.
static func plan(gen: ChunkGenerator, ix: int, iz: int) -> Dictionary:
	var field := gen.field
	var seed := gen.seed
	if WHash.unit2(seed, ix, iz, 1500) >= CHANCE:
		return {"no": "chance"}
	var cache := {}
	var x0 := ix * CELL
	var z0 := iz * CELL
	# The steepest reaches of river in the cell, from points near its centre line: first
	# roughly (straight down the river's way), then the best few traced along its course.
	var cands: Array = []
	var n := int(CELL / SCAN)
	for j in n:
		for i in n:
			var p := Vector2(x0 + (i + 0.5) * SCAN, z0 + (j + 0.5) * SCAN)
			if field.river_t(p.x, p.y) > 0.35:
				continue
			var lv := field.river_level(p.x, p.y, cache)
			if lv < ChunkGenerator.WATER_LEVEL + 2.0:
				continue
			var d := _way(field, p)
			if field.river_level(p.x + d.x * 16.0, p.y + d.y * 16.0, cache) > field.river_level(p.x - d.x * 16.0, p.y - d.y * 16.0, cache):
				d = -d
			var drop := lv - field.river_level(p.x + d.x * RUN, p.y + d.y * RUN, cache)
			if drop > MIN_DROP:
				cands.append([drop, p, d])
	if cands.is_empty():
		return {"no": "steep"}
	cands.sort_custom(func(a, b): return a[0] > b[0])
	var no := "steep"
	for c in cands.slice(0, 10):
		var f := _try(gen, c[1], c[2], cache)
		# The whole reach inside the cell, so no two falls ever share one.
		var inner := Rect2(x0 + 16.0, z0 + 16.0, CELL - 32.0, CELL - 32.0)
		if not f.has("no") and not (inner.has_point(f["lip"]) and inner.has_point(f["lip"] + f["dir"] * (RUN + FADE))):
			f = {"no": "edge"}
		if not f.has("no"):
			return _tiers(gen, ix, iz, f)
		no = f["no"]
	return {"no": no}

## A falls from near p down the way d, if the river there makes a good one.
static func _try(gen: ChunkGenerator, p: Vector2, d: Vector2, cache: Dictionary) -> Dictionary:
	var field := gen.field
	var path := _trace(field, p, d, RUN)
	if path.is_empty():
		return {"no": "lost"}
	var lip: Vector2 = path[0]
	var end: Vector2 = path[path.size() - 1]
	var dir := (end - lip).normalized()
	# A reach that bends is no place for a falls: the river keeps to the line.
	for q in path:
		if _seg_dist(q, lip, end) > 5.0:
			return {"no": "bend"}
	var top := field.river_level(lip.x, lip.y, cache)
	var bottom := field.river_level(end.x, end.y, cache)
	# Where the river runs down into a lake, the falls drops into the lake.
	var lake := bottom < ChunkGenerator.WATER_LEVEL + 1.2
	if lake:
		bottom = ChunkGenerator.WATER_LEVEL
	var drop := minf(top - bottom, MAX_DROP)
	if drop < MIN_DROP:
		return {"no": "drop"}
	# The river has to show the whole way down (not faded out under high land).
	for k in range(-2, int((RUN + FADE) / 4.0) + 1):
		var q: Vector2 = lip + dir * (k * 4.0)
		var lv := field.river_level(q.x, q.y, cache)
		if lv > ChunkGenerator.WATER_LEVEL + 1.2 and WorldField.river_strength(field.shape(q.x, q.y).x, lv) < 0.6:
			return {"no": "strength"}
	# Clear of towns, strongholds and roads.
	var box := Rect2(lip, Vector2.ZERO).expand(lip + dir * (RUN + FADE)).grow(LAT)
	var pos := box.position
	var far := box.end
	if not gen.settlements_near(pos.x - 60.0, pos.y - 60.0, far.x + 60.0, far.y + 60.0).is_empty():
		return {"no": "town"}
	if not gen.forts_near(pos.x, pos.y, far.x, far.y).is_empty():
		return {"no": "fort"}
	for rd in gen.roads_near(pos.x, pos.y, far.x, far.y):
		for rp in rd["pts"] as PackedVector2Array:
			if _seg_dist(rp, lip - dir * 10.0, lip + dir * (RUN + FADE)) < KEEP_CLEAR:
				return {"no": "road"}
	return {"lip": lip, "dir": dir, "top": top, "drop": drop, "lake": lake}

## Splits a falls' drop into its tiers.
static func _tiers(gen: ChunkGenerator, ix: int, iz: int, f: Dictionary) -> Dictionary:
	var seed := gen.seed
	var drop: float = f["drop"]
	var top: float = f["top"]
	# One sheer drop, or a stair of two or three where the fall is great.
	var r := WHash.unit2(seed, ix, iz, 1501)
	var tiers := 1
	if drop > 20.0:
		tiers = 3 if r < 0.3 else (2 if r < 0.75 else 1)
	elif drop > 11.0:
		tiers = 2 if r < 0.45 else 1
	var steps := PackedFloat32Array()
	var levels := PackedFloat32Array()
	var left := drop
	for t in tiers:
		# Higher drops first; each tier sits a little way below the last.
		var share := left if t == tiers - 1 else left * lerpf(0.45, 0.65, WHash.unit2(seed, ix, iz, 1502 + t)) * (1.0 if tiers == 2 else 0.75)
		left -= share
		steps.append(0.0 if t == 0 else RUN * (float(t) / tiers) * lerpf(0.75, 1.0, WHash.unit2(seed, ix, iz, 1505 + t)))
		levels.append(top - (drop - left))
	f["steps"] = steps
	f["levels"] = levels
	f["wob"] = Vector2(WHash.unit2(seed, ix, iz, 1508), WHash.unit2(seed, ix, iz, 1509)) * TAU
	f["cell"] = Vector2i(ix, iz)
	return f

## The way the river runs at p (either way along it), from the slope of its noise.
static func _way(field: WorldField, p: Vector2) -> Vector2:
	var g := Vector2(field.river_n(p.x + 1.0, p.y) - field.river_n(p.x - 1.0, p.y), field.river_n(p.x, p.y + 1.0) - field.river_n(p.x, p.y - 1.0))
	return Vector2(-g.y, g.x).normalized() if g.length() > 0.000001 else Vector2.RIGHT

## The river's centre line from near p, running on the way d for `length` metres, every
## 4 m. Empty if it loses the river.
static func _trace(field: WorldField, p: Vector2, d: Vector2, length: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	p = _snap(field, p)
	out.append(p)
	var go := 0.0
	while go < length:
		var w := _way(field, p)
		if w.dot(d) < 0.0:
			w = -w
		d = w
		p = _snap(field, p + d * 4.0)
		if field.river_t(p.x, p.y) > 0.2:
			return PackedVector2Array()
		out.append(p)
		go += 4.0
	return out

## p moved onto the river's centre line (two Newton steps on its noise).
static func _snap(field: WorldField, p: Vector2) -> Vector2:
	for k in 2:
		var v := field.river_n(p.x, p.y)
		var g := Vector2(field.river_n(p.x + 0.5, p.y) - field.river_n(p.x - 0.5, p.y), field.river_n(p.x, p.y + 0.5) - field.river_n(p.x, p.y - 0.5))
		var l2 := g.length_squared()
		if l2 < 0.0000001:
			break
		p -= g * v / l2
	return p

## The river's centre line near p, across the flow d (to within half a metre).
static func _centre(field: WorldField, p: Vector2, d: Vector2) -> Vector2:
	var perp := Vector2(-d.y, d.x)
	var best := p
	var bt := field.river_t(p.x, p.y)
	for k in range(-24, 25):
		var q := p + perp * (k * 0.5)
		var t := field.river_t(q.x, q.y)
		if t < bt:
			bt = t
			best = q
	return best

static func _seg_dist(p: Vector2, a: Vector2, b: Vector2) -> float:
	var ab := b - a
	var u := clampf((p - a).dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
	return p.distance_to(a + ab * u)

## How far the lip line wavers (metres along the river) at `lat` across it.
static func waver(f: Dictionary, lat: float) -> float:
	var w: Vector2 = f["wob"]
	return sin(lat * 0.19 + w.x) * 1.3 + sin(lat * 0.47 + w.y) * 0.6

## Where p lies to a falls: (s along the river from the lip, with the lip's waver taken
## out, lat across it).
static func local(f: Dictionary, x: float, z: float) -> Vector2:
	var d: Vector2 = f["dir"]
	var q := Vector2(x, z) - (f["lip"] as Vector2)
	var lat := q.x * -d.y + q.y * d.x
	return Vector2(q.dot(d) + waver(f, lat), lat)

## The river's water level at (x, z) once the falls have gathered their reach: never
## above the river's own (raw) level, at each tier's level below its drop.
static func level(falls: Array, x: float, z: float, raw: float) -> float:
	for f in falls:
		var q := local(f, x, z)
		if q.x < -0.5 or q.x > RUN + FADE or absf(q.y) > LAT:
			continue
		var steps: PackedFloat32Array = f["steps"]
		var levels: PackedFloat32Array = f["levels"]
		var cap := INF
		var above: float = f["top"]
		for t in steps.size():
			if q.x > steps[t]:
				cap = lerpf(above, levels[t], smoothstep(steps[t], steps[t] + RAMP, q.x))
				above = levels[t]
		if is_inf(cap):
			continue
		var w := (1.0 - smoothstep(LAT * 0.6, LAT, absf(q.y))) * (1.0 - smoothstep(RUN, RUN + FADE, q.x))
		raw = lerpf(raw, minf(raw, cap), w)
	return raw

## The plunge pool at each drop's foot: Vector2(extra depth below the river's bed, how far
## out in the pool (0 at its heart, 1 at its rim)), or (0, INF) outside any pool. Pools lie
## only below their drop, against the foot of the cliff.
static func pool(falls: Array, x: float, z: float) -> Vector2:
	var out := Vector2(0.0, INF)
	for f in falls:
		var q := local(f, x, z)
		if q.x < -0.5 or q.x > RUN + 20.0 or absf(q.y) > 24.0:
			continue
		var steps: PackedFloat32Array = f["steps"]
		for t in steps.size():
			var h := tier_drop(f, t)
			var c := pool_centre(h)
			var rad := pool_radius(h)
			if q.x < steps[t] + RAMP * 0.5:
				continue
			var u := Vector2(q.x - steps[t] - c, q.y).length() / rad
			if u < 1.0 and u < out.y:
				out = Vector2(clampf(h * 0.22, 1.2, 4.5) * (1.0 - u * u), u)
	return out

## Height of drop t.
static func tier_drop(f: Dictionary, t: int) -> float:
	var levels: PackedFloat32Array = f["levels"]
	return (float(f["top"]) if t == 0 else levels[t - 1]) - levels[t]

## How far out from the cliff a pool's heart lies, and its radius, for a drop of h.
static func pool_centre(h: float) -> float:
	return clampf(h * 0.18 + 2.0, 2.5, 6.0)

static func pool_radius(h: float) -> float:
	return clampf(h * 0.45 + 7.0, 8.0, 15.0)

## The drops whose lip lies in this chunk, for its water, mist and sound (kept with the
## chunk): [{edge: PackedVector3Array (the lip line, local, at the water's top, left to
## right across the flow), dir: Vector2, drop, pool: Vector3 (local, at the water)}].
static func chunk_drops(gen: ChunkGenerator, falls: Array, cx: int, cz: int) -> Array:
	var out: Array = []
	var x0 := float(cx * ChunkGenerator.SIZE)
	var z0 := float(cz * ChunkGenerator.SIZE)
	for f in falls:
		var d: Vector2 = f["dir"]
		var perp := Vector2(-d.y, d.x)
		var steps: PackedFloat32Array = f["steps"]
		var levels: PackedFloat32Array = f["levels"]
		for t in steps.size():
			var lip: Vector2 = (f["lip"] as Vector2) + d * steps[t]
			lip = _centre(gen.field, lip, d)
			if lip.x < x0 or lip.x >= x0 + ChunkGenerator.SIZE or lip.y < z0 or lip.y >= z0 + ChunkGenerator.SIZE:
				continue
			var top: float = float(f["top"]) if t == 0 else levels[t - 1]
			var h := tier_drop(f, t)
			# Across the water at the lip: out to where the river's channel ends each side.
			var lat0 := local(f, lip.x, lip.y).y
			var half := Vector2.ZERO
			for side in 2:
				var sg := -1.0 if side == 0 else 1.0
				var k := 0.0
				while k < 30.0:
					var q := lip + perp * sg * (k + 0.5)
					if gen.field.river_t(q.x, q.y) > 0.92:
						break
					k += 0.5
				half[side] = maxf(k, 2.0)
			var edge := PackedVector3Array()
			var n := int(ceil((half.x + half.y) / 1.0))
			for e in n + 1:
				var lat := lat0 - half.x + (half.x + half.y) * e / float(n)
				# Back onto the wavering lip line at this point across.
				var q := (f["lip"] as Vector2) + perp * lat
				q += d * (steps[t] - waver(f, lat))
				edge.append(Vector3(q.x - x0, top, q.y - z0))
			var pc := lip + d * (pool_centre(h) + RAMP * 0.5)
			out.append({"edge": edge, "dir": d, "drop": h, "pool": Vector3(pc.x - x0, levels[t], pc.y - z0), "radius": pool_radius(h)})
	return out
